# KisanMitra AI - Environment Configuration Example
# Copy this file to .env and fill in your API keys

DEMO_MODE=true
DEFAULT_LANGUAGE=hi

# Weather API (OpenWeatherMap)
WEATHER_API_KEY=your_weather_api_key_here

# AI Assistant (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Market Price API (Agmarknet / eNAM)
MARKET_API_KEY=your_market_api_key_here

# Plant Disease Detection
DISEASE_API_URL=https://api-inference.huggingface.co/models/your-model
HF_API_TOKEN=your_huggingface_token_here

# App Config
APP_NAME=KisanMitra AI
APP_VERSION=1.0.0
